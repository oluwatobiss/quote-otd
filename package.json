{
  "name": "quote-otd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "build": "rm -rf ./dist && npm run compile && tsc && vite build --mode preprod && cp -r contracts/managed/quote-otd/keys ./dist/keys && cp -r contracts/managed/quote-otd/zkir ./dist/zkir",
    "build:preview": "rm -rf ./dist && npm run compile && tsc && vite build --mode preview && cp -r contracts/managed/quote-otd/keys ./dist/keys && cp -r contracts/managed/quote-otd/zkir ./dist/zkir",
    "build:start": "npm run build && npm run start",
    "build:start:preview": "npm run build:preview && npm run start",
    "ci": "npm run compile && npm run typecheck && npm run lint && npm run build:preview",
    "compile": "compact compile contracts/quote-otd.compact contracts/managed/quote-otd",
    "deploy": "vite-node scripts/deploy.ts",
    "deploy:preprod": "MIDNIGHT_NETWORK=preprod npm run deploy",
    "deploy:preview": "MIDNIGHT_NETWORK=preview npm run deploy",
    "dev": "vite",
    "env:down": "docker compose down",
    "env:up": "docker compose up -d --wait",
    "lint": "eslint src",
    "prepack": "npm run build",
    "preview": "vite preview",
    "proof:down": "docker compose stop proof-server",
    "proof:up": "docker compose up -d --wait proof-server",
    "start": "http-server --port 0 ./dist",
    "test": "NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "test:local": "MIDNIGHT_NETWORK=local npm run test",
    "test:preprod": "MIDNIGHT_NETWORK=preprod npm run test",
    "test:preview": "MIDNIGHT_NETWORK=preview npm run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run env:up && npm run test:local && npm run env:down"
  },
  "dependencies": {
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "axios": "^1.15.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "^7.8.2",
    "testcontainers": "^11.13.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.9",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "resolutions": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0"
  }
}
